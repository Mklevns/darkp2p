# docker compose passes this whole file to the darkp2p container (env_file) and
# also uses it to fill in docker-compose.yml. Keep it chmod 600.

DOMAIN=darkp2p.com

# v3 .onion hostname of the bundled Tor hidden service. Leave empty until tor
# has generated it (see README). Onion traffic reaches darkp2p on its own
# listener, ONION_PORT=3001, which docker-compose.yml sets; outside compose,
# ONION_HOST without ONION_PORT refuses to start.
ONION_HOST=

TURN_HOST=turn.darkp2p.com
# Required by scripts/gen-turnserver-conf.sh, which writes coturn's config:
# the server's public IPv4. scripts/check-turn-relay.sh tests the relay at
# this address. Re-run the generator after changing TURN_HOST, TURN_PUBLIC_IP
# or TURN_SECRET.
TURN_PUBLIC_IP=
TURN_SECRET=
TURN_TTL=3600

PRO_TOKEN_SECRET=
PRO_TOKEN_DAYS=30
# Claim window in hours (1-168, default 48): how long a paid Pro token can be
# fetched by payment ID. It runs from the payment's created_at + 6 h
# settlement grace, and holds across restarts. Afterwards /api/claim -> 404.
CLAIM_TTL_HOURS=48

# NOWPayments checkout. Without an API key the Pro checkout buttons stay
# hidden and /api/checkout and /webhook/nowpayments are disabled.
# In the NOWPayments dashboard: create an API key, and under IPN settings
# generate the IPN secret. Invoices are created with
# ipn_callback_url=https://<DOMAIN>/webhook/nowpayments, so no callback URL
# has to be configured there.
NOWPAYMENTS_API_KEY=
# Required when NOWPAYMENTS_API_KEY is set (PRO_TOKEN_SECRET is too).
NOWPAYMENTS_IPN_SECRET=
# Optional: defaults to https://api.nowpayments.io. For testing, the sandbox
# is https://api-sandbox.nowpayments.io (with sandbox keys).
NOWPAYMENTS_API_URL=
# Prices in USD (positive, at most 2 decimals). Shown on the page and charged.
PRO_1D_PRICE_USD=2
PRO_30D_PRICE_USD=5

# Public tip addresses, injected into the page at boot. Each is optional: its
# tip button is hidden when unset.
# Mainnet only. XMR: standard (4…) or subaddress (8…), 95 characters, or
# integrated (4…, 106). BTC: bc1q…/bc1p… (lowercase) or legacy 1…/3….
TIP_XMR_ADDRESS=
TIP_BTC_ADDRESS=
