# docker compose passes this whole file to the darkp2p container (env_file) and
# also uses it to fill in docker-compose.yml. Keep it chmod 600.

DOMAIN=darkp2p.com

# v3 .onion hostname of the bundled Tor hidden service. Leave empty until tor
# has generated it (see README). Onion traffic reaches darkp2p on its own
# listener, ONION_PORT=3001, which docker-compose.yml sets; outside compose,
# ONION_HOST without ONION_PORT refuses to start.
ONION_HOST=

TURN_HOST=turn.darkp2p.com
# Required by docker-compose.yml: the server's public IPv4. coturn refuses to
# relay to it, so TURN cannot be used to reach services on the host itself.
TURN_PUBLIC_IP=
TURN_SECRET=
TURN_TTL=3600

PRO_TOKEN_SECRET=
PRO_TOKEN_DAYS=30
# Claim window in hours (1-168, default 48): how long a paid Pro token can be
# fetched by invoice ID. With BTCPay lookup configured it runs from invoice
# creation + 6 h settlement grace, and holds across restarts; without lookup
# it runs from when the webhook minted the token. Afterwards /api/claim -> 404.
CLAIM_TTL_HOURS=48
BTCPAY_WEBHOOK_SECRET=
