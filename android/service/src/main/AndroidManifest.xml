<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Holds the room while files move. Reachable only from this app. -->
        <service
            android:name="com.darkp2p.service.DarkP2PService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps an onion file drop reachable while the app is in the background. Reachable only from this app. -->
        <service
            android:name="com.darkp2p.service.DropService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
