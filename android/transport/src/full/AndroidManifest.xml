<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- From Android 17, without this the system drops everything between the app and
         other devices on the same network, so two devices on one Wi-Fi cannot connect
         directly. It is never asked for up front: the room offers it only after a
         connection fell back to the relay with both sides behind the same router. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Data channels only: whatever the WebRTC library's own manifest asks for, no audio or Bluetooth here.
         (The camera is not listed: the app itself asks for it, to scan QR codes.) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

</manifest>
