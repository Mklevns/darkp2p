<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- libwebrtc picks its routes with this. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Data channels only: whatever the WebRTC library's own manifest asks for, no audio or Bluetooth here.
         (The camera is not listed: the app itself asks for it, to scan QR codes.) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

</manifest>
