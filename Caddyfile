{
    servers {
        timeouts {
            read_header 10s
        }
    }
}

# Port 80 is left to Caddy's automatic HTTP->HTTPS redirect and its ACME
# HTTP-01 handling: no hand-written http:// block (Step 10 decision in
# docs/remediation/PROGRESS.md).
www.{$DOMAIN} {
    header -Server
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
    header -Server
    encode zstd gzip
    request_body /webhook/nowpayments {
        max_size 64KB
    }
    reverse_proxy darkp2p:3000 {
        stream_close_delay 5m
    }
}
